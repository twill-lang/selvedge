mode systems

# The scratch directory the file-writing suites share.
#
# The assertions that used to live here are twill 1.11's `std/test`, which
# every suite imports directly; what is left is the one thing a test runner
# cannot supply, a place for a test to write. A suite that writes files imports
# this as `h` beside `std/test` as `t`, and calls `h.cleanup()` before
# `t.report(...)`, since `report` no longer runs it.
#
# Test names are written as sentences, because a failing test's name is the only
# documentation anyone reads at the moment it fails.

# ---- scratch files ---------------------------------------------------------
#
# Tests that write files used to write them next to the source, under names
# beginning with `tmp_`, because there was nowhere else to put them and no way
# to remove them afterwards. Seven of those files ended up committed to the
# repository, which is what happens to litter nobody can sweep up: they look
# like fixtures, so the next person leaves them alone.
#
# `temp_dir` and `remove_all` are what fix it. The directory is created on first
# use, so a suite that writes nothing creates nothing, and `cleanup` removes it.
# The suites call it before `report`, so it runs on the failure path as well as
# the success one.

struct Scratch {
  dir: Str,
  made: Bool,
}

let SCRATCH = Scratch { dir: "", made: false }

# A path inside this run's scratch directory. Two calls with the same name give
# the same path, which is what a test that writes a file and then reads it back
# wants.
fn tmp(name: Str) -> Str {
  if not SCRATCH.made {
    SCRATCH.dir = match temp_dir("selvedge-test") {
      Ok(d) => d,
      # An abort and not a Res. A suite that cannot create a scratch directory
      # cannot run, and there is no caller who could do anything about it.
      Err(e) => abort("cannot create a scratch directory for the tests: " + e),
    }
    SCRATCH.made = true
  }
  path_join(SCRATCH.dir, name)
}

fn cleanup() {
  if SCRATCH.made {
    match remove_all(SCRATCH.dir) {
      Ok(_) => unit,
      # Reported and not fatal: the tests' verdict is about the code under test,
      # and a scratch directory that outlived the run should not turn a passing
      # suite red. It should be visible, hence the line.
      Err(e) => print("warning: could not remove " + SCRATCH.dir + ": " + e),
    }
    SCRATCH.made = false
  }
}
